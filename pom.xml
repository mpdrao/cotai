<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>dev.cotai</groupId>
    <artifactId>cotai</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>cotai</name>
    <description>Gift registry with quotas for any event (Spring Boot + Angular monorepo).</description>

    <properties>
        <java.version>21</java.version>
        <node.version>v24.21.0</node.version>
        <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
    </properties>

    <modules>
        <module>api</module>
    </modules>

    <profiles>
        <!--
          Builds the Angular SPA (web/) and bundles it into the API jar under /static.
          Active by default; skip it with -DskipWeb for a backend-only build.
        -->
        <profile>
            <id>bundle-web</id>
            <activation>
                <property>
                    <name>!skipWeb</name>
                </property>
            </activation>
            <modules>
                <module>web</module>
            </modules>
        </profile>
    </profiles>
</project>
