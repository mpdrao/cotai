<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="COTAI - API, Web Angular e carga combinada">
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variaveis do Plano">
        <collectionProp name="Arguments.arguments">
          <elementProp name="scenario" elementType="Argument">
            <stringProp name="Argument.name">scenario</stringProp>
            <stringProp name="Argument.value">api</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="apiProtocol" elementType="Argument">
            <stringProp name="Argument.name">apiProtocol</stringProp>
            <stringProp name="Argument.value">${__P(apiProtocol,http)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="apiHost" elementType="Argument">
            <stringProp name="Argument.name">apiHost</stringProp>
            <stringProp name="Argument.value">${__P(apiHost,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="apiPort" elementType="Argument">
            <stringProp name="Argument.name">apiPort</stringProp>
            <stringProp name="Argument.value">${__P(apiPort,8080)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="frontendProtocol" elementType="Argument">
            <stringProp name="Argument.name">frontendProtocol</stringProp>
            <stringProp name="Argument.value">${__P(frontendProtocol,http)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="frontendHost" elementType="Argument">
            <stringProp name="Argument.name">frontendHost</stringProp>
            <stringProp name="Argument.value">${__P(frontendHost,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="frontendPort" elementType="Argument">
            <stringProp name="Argument.name">frontendPort</stringProp>
            <stringProp name="Argument.value">${__P(frontendPort,4200)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="webThreads" elementType="Argument">
            <stringProp name="Argument.name">webThreads</stringProp>
            <stringProp name="Argument.value">${__P(webThreads,20)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="apiThreads" elementType="Argument">
            <stringProp name="Argument.name">apiThreads</stringProp>
            <stringProp name="Argument.value">${__P(apiThreads,20)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="raceThreads" elementType="Argument">
            <stringProp name="Argument.name">raceThreads</stringProp>
            <stringProp name="Argument.value">${__P(raceThreads,20)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="rampSeconds" elementType="Argument">
            <stringProp name="Argument.name">rampSeconds</stringProp>
            <stringProp name="Argument.value">${__P(rampSeconds,30)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="loopCount" elementType="Argument">
            <stringProp name="Argument.name">loopCount</stringProp>
            <stringProp name="Argument.value">${__P(loopCount,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="totalQuotas" elementType="Argument">
            <stringProp name="Argument.name">totalQuotas</stringProp>
            <stringProp name="Argument.value">${__P(totalQuotas,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="squidEnabled" elementType="Argument">
            <stringProp name="Argument.name">squidEnabled</stringProp>
            <stringProp name="Argument.value">${__P(squidEnabled,false)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="recorderPort" elementType="Argument">
            <stringProp name="Argument.name">recorderPort</stringProp>
            <stringProp name="Argument.value">${__P(recorderPort,8081)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
