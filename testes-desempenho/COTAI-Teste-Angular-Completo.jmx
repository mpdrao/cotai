            <stringProp name="script">props.put(&apos;sharedAccessToken&apos;, vars.get(&apos;accessToken&apos;))
props.put(&apos;sharedGiftListId&apos;, vars.get(&apos;giftListId&apos;))
props.put(&apos;sharedSlug&apos;, vars.get(&apos;slug&apos;))
props.put(&apos;sharedItemId&apos;, vars.get(&apos;itemId&apos;))</stringProp>
            <stringProp name="parameters"></stringProp>
