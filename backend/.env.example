# Credenciais usadas exclusivamente pelo backend para autenticar no Squid.
# Troque a senha antes de iniciar o ambiente.
PROXY_USERNAME=cotai_proxy
PROXY_PASSWORD=troque-por-uma-senha-com-mais-de-12-caracteres

# O backend local acessa a porta publicada pelo Docker no loopback.
COTAI_PROXY_ENABLED=true
COTAI_PROXY_HOST=127.0.0.1
COTAI_PROXY_PORT=3128
